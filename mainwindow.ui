  <property name="styleSheet">
   <string notr="true">
/* STYLE GLOBAL */
QMainWindow, QWidget#centralwidget { background-color: #f4f1ea; font-family: &quot;Segoe UI&quot;; color: #4e342e; }

/* BARRE LATERALE (Restauration du menu global) */
QFrame#frame_sidebar { background-color: #3e2723; min-width: 230px; border-right: 1px solid #281a17; }
QLabel#label_logo { color: #ffffff; font-weight: bold; font-size: 18px; padding: 10px; background-color: rgba(255,255,255,0.05); border-radius: 10px; }
QPushButton.sidebar_btn { text-align: left; padding: 12px 20px; border: none; background-color: transparent; color: #efebe9; border-radius: 20px; font-weight: 500; margin-bottom: 5px; }
QPushButton.sidebar_btn:hover { background-color: #5d4037; color: #ffffff; }

/* ONGLETS ET CARTES */
QTabBar::tab { background: #d7ccc8; color: #5d4037; padding: 10px 25px; font-weight: bold; border-top-left-radius: 15px; border-top-right-radius: 15px; margin-right: 5px; }
QTabBar::tab:selected { background: #ffffff; color: #3e2723; border-bottom: 3px solid #3e2723; }
QGroupBox { background-color: #ffffff; border: 1px solid #d7ccc8; border-radius: 15px; margin-top: 30px; font-weight: bold; color: #3e2723; padding: 20px; border-bottom: 3px solid #d7ccc8; }

/* CHAMPS ET BOUTONS SPECIFIQUES */
QLineEdit, QComboBox, QDoubleSpinBox, QDateEdit { background-color: #fffdf9; border: 1px solid #bcaaa4; border-radius: 15px; padding: 6px 15px; }
QPushButton#btn_compare { background-color: #00838f; color: white; border-radius: 20px; padding: 10px 25px; font-weight: bold; }
QPushButton#btn_besoin { background-color: #f9a825; color: white; border-radius: 20px; padding: 10px 25px; font-weight: bold; }
QLabel#lbl_iot_temp, QLabel#lbl_iot_hum { background-color: #3e2723; color: #fff176; border-radius: 15px; padding: 10px; font-family: &quot;Consolas&quot;, monospace; font-weight: bold; border: 2px solid #5d4037; }

/* TABLEAUX */
QHeaderView::section { background-color: #8d6e63; color: white; padding: 12px; font-weight: bold; border: none; }
   </string>
